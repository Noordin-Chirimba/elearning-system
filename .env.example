# Copy the required values into your server environment.
# Do not commit a real .env file or real credentials.

DB_HOST=127.0.0.1
DB_USER=your_local_database_user
DB_PASSWORD=replace_with_local_database_password
DB_NAME=e-learningsystem

SMTP_USERNAME=your_sender_email@example.com
SMTP_PASSWORD=replace_with_a_new_app_password

STRIPE_SECRET_KEY=replace_with_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=replace_with_your_stripe_webhook_signing_secret

# Base URL of the application, with no trailing slash.
APP_BASE_URL=http://localhost/ELearningSystems
